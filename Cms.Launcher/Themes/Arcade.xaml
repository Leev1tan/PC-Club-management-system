<!-- Lock screen theme "arcade" (night purple, coin yellow and pink, pixel headings). The colours are the dark block of admin-ui/app/themes.css
     ([data-theme="arcade"][data-mode="dark"]); tests/Cms.Client.Tests/LauncherThemeTests.cs keeps them equal.
     Cms.Launcher/ThemeManager puts this dictionary at App.Resources.MergedDictionaries[0]; an owner accent replaces the accent keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="Brush.BgAbyss" Color="#120A26"/>
    <SolidColorBrush x:Key="Brush.BgDark" Color="#170D30"/>
    <SolidColorBrush x:Key="Brush.BgPanel" Color="#1D1240"/>
    <SolidColorBrush x:Key="Brush.BgCard" Color="#24174D"/>
    <SolidColorBrush x:Key="Brush.BgElevated" Color="#2D1D5C"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#4A3388"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#FFF8E7"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#D9CFF5"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#B8ACDF"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFD23F"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFD23F"/>
    <SolidColorBrush x:Key="Brush.AccentContrast" Color="#120A26"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="#3DFF9A"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFB13D"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF8BA6"/>
    <SolidColorBrush x:Key="Brush.Event" Color="#FF8CF0"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#F8120A26"/>
    <Color x:Key="Color.Accent">#FFD23F</Color>
    <Color x:Key="Color.Danger">#FF8BA6</Color>
    <Color x:Key="Color.Ok">#3DFF9A</Color>
    <Color x:Key="Color.Warn">#FFB13D</Color>
    <FontFamily x:Key="Font.Display">pack://application:,,,/Cms.Launcher;component/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Cms.Launcher;component/Fonts/#Rubik</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Cms.Launcher;component/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Font.Wordmark">pack://application:,,,/Cms.Launcher;component/Fonts/#Press Start 2P</FontFamily>
    <CornerRadius x:Key="Radius.Small">0</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">0</CornerRadius>
    <sys:Double x:Key="Glow.Opacity">0.3</sys:Double>
</ResourceDictionary>
