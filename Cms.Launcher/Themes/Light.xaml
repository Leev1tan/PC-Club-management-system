<!-- Lock screen theme "light" (warm paper, deep teal accent). The colours are the light block of admin-ui/app/themes.css
     ([data-theme="light"][data-mode="light"]); tests/Cms.Client.Tests/LauncherThemeTests.cs keeps them equal.
     Cms.Launcher/ThemeManager puts this dictionary at App.Resources.MergedDictionaries[0]; an owner accent replaces the accent keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="Brush.BgAbyss" Color="#F4F2EE"/>
    <SolidColorBrush x:Key="Brush.BgDark" Color="#FAF9F6"/>
    <SolidColorBrush x:Key="Brush.BgPanel" Color="#FFFEFB"/>
    <SolidColorBrush x:Key="Brush.BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.BgElevated" Color="#F6F4EF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#E0DBD1"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#1D1B17"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4A463E"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#625D53"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#10665E"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#10665E"/>
    <SolidColorBrush x:Key="Brush.AccentContrast" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="#286729"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#7F5202"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#AA251E"/>
    <SolidColorBrush x:Key="Brush.Event" Color="#6A3FB5"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#F8F4F2EE"/>
    <Color x:Key="Color.Accent">#10665E</Color>
    <Color x:Key="Color.Danger">#AA251E</Color>
    <Color x:Key="Color.Ok">#286729</Color>
    <Color x:Key="Color.Warn">#7F5202</Color>
    <FontFamily x:Key="Font.Display">pack://application:,,,/Cms.Launcher;component/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Cms.Launcher;component/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Cms.Launcher;component/Fonts/#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="Font.Wordmark">pack://application:,,,/Cms.Launcher;component/Fonts/#IBM Plex Sans</FontFamily>
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">10</CornerRadius>
    <sys:Double x:Key="Glow.Opacity">0</sys:Double>
</ResourceDictionary>
