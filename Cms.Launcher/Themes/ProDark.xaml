<!-- Lock screen theme "pro-dark" (graphite, one blue accent, no glow). The colours are the dark block of admin-ui/app/themes.css
     ([data-theme="pro-dark"][data-mode="dark"]); tests/Cms.Client.Tests/LauncherThemeTests.cs keeps them equal.
     Cms.Launcher/ThemeManager puts this dictionary at App.Resources.MergedDictionaries[0]; an owner accent replaces the accent keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="Brush.BgAbyss" Color="#0E1014"/>
    <SolidColorBrush x:Key="Brush.BgDark" Color="#13161B"/>
    <SolidColorBrush x:Key="Brush.BgPanel" Color="#171A20"/>
    <SolidColorBrush x:Key="Brush.BgCard" Color="#1B1F26"/>
    <SolidColorBrush x:Key="Brush.BgElevated" Color="#222731"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2C323D"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B0B8C4"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#929BAB"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#7FB0FB"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#7FB0FB"/>
    <SolidColorBrush x:Key="Brush.AccentContrast" Color="#0E1014"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="#4CC26A"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#E0A530"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#F88C87"/>
    <SolidColorBrush x:Key="Brush.Event" Color="#BD9DFC"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#F80E1014"/>
    <Color x:Key="Color.Accent">#7FB0FB</Color>
    <Color x:Key="Color.Danger">#F88C87</Color>
    <Color x:Key="Color.Ok">#4CC26A</Color>
    <Color x:Key="Color.Warn">#E0A530</Color>
    <FontFamily x:Key="Font.Display">pack://application:,,,/Cms.Launcher;component/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Cms.Launcher;component/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Cms.Launcher;component/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Font.Wordmark">pack://application:,,,/Cms.Launcher;component/Fonts/#Inter</FontFamily>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <sys:Double x:Key="Glow.Opacity">0</sys:Double>
</ResourceDictionary>
