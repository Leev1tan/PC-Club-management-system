{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Server": {
    "BaseUrl": ""
  },
  "Teardown": {
    "KillProcessNames": [
      "steam", "steamwebhelper", "EpicGamesLauncher", "EpicWebHelper", "Battle.net", "RiotClientServices", "RiotClientUx",
      "EADesktop", "Origin", "GalaxyClient", "upc", "Discord", "Telegram", "chrome", "msedge", "firefox", "opera", "brave"
    ],
    "Cleanup": {
      "Enabled": false,
      "AllowedRoots": [ "%LOCALAPPDATA%", "%APPDATA%" ],
      "Paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data",
        "%APPDATA%\\Mozilla\\Firefox\\Profiles",
        "%APPDATA%\\discord\\Local Storage",
        "%APPDATA%\\discord\\Session Storage",
        "%LOCALAPPDATA%\\Steam\\htmlcache",
        "%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\webcache",
        "%APPDATA%\\Telegram Desktop\\tdata"
      ]
    }
  }
}
