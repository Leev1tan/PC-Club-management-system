# Copy to .env and adjust. docker compose reads .env automatically. Never commit .env.

# Database password (PostgreSQL is not published outside the compose network).
# Use letters and digits only (it is embedded in a connection string).
POSTGRES_PASSWORD=change-me

# Published port for the admin UI and the API (/api). 5081 = same URL as the Windows installer,
# so club PCs and MikroTik rules from docs/ClubDeployment.md work unchanged.
# CMS_BIND_ADDRESS: 0.0.0.0 = all interfaces; 127.0.0.1 = this host only (e.g. behind a reverse proxy).
CMS_BIND_ADDRESS=0.0.0.0
CMS_PORT=5081

# Demo club with 20 simulated PCs. Use only with an empty database: demo mode wipes it
# on start and every DEMO_RESET_HOURS hours (it refuses to start on a database with real data).
DEMO_MODE=false
DEMO_RESET_HOURS=6

# Pre-built images (optional), for example from GitHub Container Registry:
# CMS_SERVER_IMAGE=ghcr.io/<owner>/ccms-server:<version>
# CMS_UI_IMAGE=ghcr.io/<owner>/ccms-admin-ui:<version>
